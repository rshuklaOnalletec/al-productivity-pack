{
  "name": "al-productivity-pack",
  "displayName": "AL Productivity Pack",
  "description": "A suite of productivity tools for Business Central AL developers — Event Subscriber Finder, boilerplate generation, event chain visualization, Page Script generation, Dataverse integration, and more.",
  "version": "0.3.0",
  "publisher": "RishabhShukla",
  "author": {
    "name": "Rishabh Shukla"
  },
  "license": "MIT",
  "icon": "resources/icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rshuklaOnalletec/al-productivity-pack"
  },
  "bugs": {
    "url": "https://github.com/rshuklaOnalletec/al-productivity-pack/issues"
  },
  "homepage": "https://github.com/rshuklaOnalletec/al-productivity-pack#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "AL",
    "Business Central",
    "BC",
    "Dynamics 365",
    "Event Subscriber",
    "Dataverse",
    "CDS",
    "NAV",
    "ERP",
    "Microsoft Dynamics"
  ],
  "activationEvents": [
    "onLanguage:al",
    "workspaceContains:**/*.al",
    "onCommand:alProductivityPack.generateDataverseIntegration"
  ],
  "telemetry": true,
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "alProductivityPack.findEvents",
        "title": "ALP: Find Published Events",
        "icon": "$(search)"
      },
      {
        "command": "alProductivityPack.findSubscribers",
        "title": "ALP: Find Event Subscribers"
      },
      {
        "command": "alProductivityPack.generateSubscriber",
        "title": "ALP: Generate Event Subscriber Boilerplate"
      },
      {
        "command": "alProductivityPack.showEventChain",
        "title": "ALP: Show Event Chain"
      },
      {
        "command": "alProductivityPack.detectDeadSubscribers",
        "title": "ALP: Detect Dead Subscribers"
      },
      {
        "command": "alProductivityPack.refreshIndex",
        "title": "ALP: Refresh Event Index",
        "icon": "$(refresh)"
      },
      {
        "command": "alProductivityPack.generateSubscriberForEvent",
        "title": "ALP: Generate Subscriber for Event"
      },
      {
        "command": "alProductivityPack.peekSubscribersAtCursor",
        "title": "ALP: Peek Subscribers at Cursor"
      },
      {
        "command": "alProductivityPack.peekDependenciesAtCursor",
        "title": "ALP: Peek Cross-References at Cursor"
      },
      {
        "command": "alProductivityPack.fileInsights",
        "title": "ALP: File Insights",
        "icon": "$(symbol-event)"
      },
      {
        "command": "alProductivityPack.showAppDependencyGraph",
        "title": "ALP: Show App Dependency Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "alProductivityPack.generatePageScript",
        "title": "ALP: Generate Page Script from Repro Steps",
        "icon": "$(play-circle)"
      },
      {
        "command": "alProductivityPack.generateDataverseIntegration",
        "title": "ALP: Generate Dataverse Integration Boilerplate",
        "icon": "$(cloud)"
      },
      {
        "command": "alProductivityPack.clearDataverseCredentials",
        "title": "ALP: Clear Dataverse Credential Cache",
        "icon": "$(key)"
      },
      {
        "command": "alProductivityPack.addTelemetry",
        "title": "ALP: Add Telemetry (AI)",
        "icon": "$(sparkle)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alProductivityPack",
          "title": "AL Productivity Pack",
          "icon": "$(symbol-event)"
        }
      ]
    },
    "views": {
      "alProductivityPack": [
        {
          "id": "alEventExplorer",
          "name": "Events & Subscribers"
        },
        {
          "id": "alDependencyExplorer",
          "name": "Cross-Extension Dependencies"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "alEventExplorer",
        "contents": "No AL events indexed yet.\n[Refresh Index](command:alProductivityPack.refreshIndex)\n\nOpen a folder with .al files or configure search paths in settings."
      },
      {
        "view": "alDependencyExplorer",
        "contents": "No dependencies indexed yet.\n[Refresh Index](command:alProductivityPack.refreshIndex)\n\nConfigure searchPaths to include sibling extensions."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "alProductivityPack.refreshIndex",
          "when": "view == alEventExplorer",
          "group": "navigation"
        },
        {
          "command": "alProductivityPack.refreshIndex",
          "when": "view == alDependencyExplorer",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "alProductivityPack.peekSubscribersAtCursor",
          "when": "editorLangId == al",
          "group": "alProductivityPack@1"
        },
        {
          "command": "alProductivityPack.peekDependenciesAtCursor",
          "when": "editorLangId == al",
          "group": "alProductivityPack@2"
        },
        {
          "command": "alProductivityPack.generateSubscriber",
          "when": "editorLangId == al",
          "group": "alProductivityPack@3"
        },
        {
          "command": "alProductivityPack.showEventChain",
          "when": "editorLangId == al",
          "group": "alProductivityPack@4"
        },
        {
          "command": "alProductivityPack.addTelemetry",
          "when": "editorLangId == al",
          "group": "alProductivityPack@5"
        }
      ],
      "editor/title": [
        {
          "command": "alProductivityPack.fileInsights",
          "when": "editorLangId == al",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AL Productivity Pack",
      "properties": {
        "alProductivityPack.searchPaths": {
          "type": "array",
          "default": [],
          "description": "Additional paths to scan for AL files (e.g., .alpackages folder for base app symbols)."
        },
        "alProductivityPack.includeBaseApp": {
          "type": "boolean",
          "default": true,
          "description": "Include Base Application events in the index."
        },
        "alProductivityPack.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh the event index when AL files change."
        },
        "alProductivityPack.dataverse.serviceUrl": {
          "type": "string",
          "default": "",
          "description": "Default Dataverse environment URL for ALP Dataverse generator (for example: https://org.crm8.dynamics.com)."
        },
        "alProductivityPack.dataverse.clientId": {
          "type": "string",
          "default": "",
          "description": "Default Microsoft Entra app client ID for ALP Dataverse generator."
        },
        "alProductivityPack.dataverse.redirectUri": {
          "type": "string",
          "default": "",
          "description": "Optional redirect URI for ALP Dataverse generator (for example: http://localhost). Leave empty to let altpgen use its default behavior."
        },
        "alProductivityPack.dataverse.altpgenPath": {
          "type": "string",
          "default": "",
          "description": "Optional full path to altpgen.exe. Use this if ALP cannot auto-locate altpgen from your AL extension installation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3"
  }
}
