{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "watch",
      "command": "node",
      "args": ["node_modules/typescript/bin/tsc", "-watch", "-p", "tsconfig.json"],
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "compile",
      "command": "node",
      "args": ["node_modules/typescript/bin/tsc", "-p", "tsconfig.json"],
      "problemMatcher": "$tsc",
      "group": "build"
    }
  ]
}
